# Run node scripts/configure.mjs to generate unique secrets. Never commit actual .env.
SOURCE_KEY=replace-with-a-random-secret-at-least-32-characters
JDBC_GATEWAY_TOKEN=replace-with-a-random-secret-at-least-32-characters
JDBC_GATEWAY_URL=http://127.0.0.1:8081
PRISM_ADMIN_USER=admin
PRISM_ADMIN_PASSWORD=replace-with-your-admin-password
# Only used for Compose's isolated runner hostname; do not enable for external endpoints.
# JDBC_ALLOW_INTERNAL_HTTP=true
